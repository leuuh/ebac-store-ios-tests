# Copie este arquivo para ".env" e preencha com suas credenciais reais do Sauce Labs.
# O ".env" está no .gitignore e nunca deve ser commitado.
#
# Pegue os valores em: https://app.saucelabs.com -> Account -> User Settings
SAUCE_USERNAME=seu-usuario-saucelabs
SAUCE_ACCESS_KEY=sua-access-key-saucelabs

# Define em qual ambiente rodar: "sauce" (nuvem) ou vazio (simulador local).
RUN_ON=sauce
